        { "code": "sound_level_dba", "name": "Sound Level", "datatype": "number", "unit_family": "sound", "canonical_unit": "dBA", "min": 10, "max": 130, "required_for": ["enhanced"], "aliases": ["sound level", "noise level", "sound power", "dba", "acoustic"] },
