      "attributes": [
        { "code": "fitting_type", "name": "Fitting Type", "datatype": "enum", "allowed_values": ["90 Elbow", "45 Elbow", "Tee", "Cross", "Coupling", "Reducer", "Union", "Cap", "Plug", "Nipple", "Bushing", "Flange"], "required_for": ["core"], "variant_defining": true, "aliases": ["fitting type", "type", "style", "configuration"] },
