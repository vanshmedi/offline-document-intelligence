      "attributes": [
        { "code": "control_type", "name": "Control Type", "datatype": "enum", "allowed_values": ["Non-Programmable", "5-1-1 Programmable", "7-Day Programmable", "Smart / Wi-Fi Connected"], "required_for": ["core"], "variant_defining": true, "aliases": ["control type", "programmability", "type", "programming"] },
