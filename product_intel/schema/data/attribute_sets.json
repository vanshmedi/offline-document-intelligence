        { "code": "pressure_rating_bar", "name": "Pressure Rating", "datatype": "number", "unit_family": "pressure", "canonical_unit": "bar", "min": 0.5, "max": 700, "required_for": ["core"], "aliases": ["pressure rating", "working pressure", "wog", "rated pressure", "class", "psi"] },
        { "code": "operating_temp_max_c", "name": "Max Operating Temperature", "datatype": "number", "unit_family": "temperature", "canonical_unit": "degC", "min": 0, "max": 800, "required_for": ["enhanced"], "aliases": ["max operating temperature", "maximum temperature", "temperature rating"] },
        { "code": "length_mm", "name": "Overall Length", "datatype": "number", "unit_family": "length", "canonical_unit": "mm", "min": 3, "max": 6000, "required_for": ["ecommerce"], "aliases": ["length", "overall length", "l", "center to end"] },
        { "code": "surface_finish", "name": "Surface Finish", "datatype": "enum", "allowed_values": ["Galvanized", "Black", "Chrome Plated", "Nickel Plated", "Mill Finish", "Passivated"], "required_for": ["enhanced"], "aliases": ["finish", "surface finish", "coating", "plating"] }
      ],
      "rules": [
        { "id": "pf_sch80_pressure", "type": "implication", "if": "schedule == 'SCH 80'", "then_min": { "pressure_rating_bar": 10 }, "message": "SCH 80 fittings should carry a pressure rating of at least 10 bar." }
      ]
    },

    "hvac_blower": {
      "attributes": [
        { "code": "airflow_m3h", "name": "Airflow", "datatype": "number", "unit_family": "flow", "canonical_unit": "m3/h", "min": 1, "max": 500000, "required_for": ["core"], "variant_defining": true, "aliases": ["airflow", "air flow", "cfm", "flow rate", "capacity", "air volume", "rated airflow"] },
        { "code": "static_pressure_bar", "name": "Static Pressure", "datatype": "number", "unit_family": "pressure", "canonical_unit": "bar", "min": 1e-05, "max": 1, "required_for": ["ecommerce"], "aliases": ["static pressure", "esp", "external static pressure", "pressure", "in. w.g.", "inches water"] },
        { "code": "motor_power_w", "name": "Motor Power", "datatype": "number", "unit_family": "power", "canonical_unit": "W", "min": 1, "max": 500000, "required_for": ["core"], "variant_defining": true, "aliases": ["motor power", "power", "hp", "motor rating", "input power", "watts"] },
        { "code": "voltage_v", "name": "Supply Voltage", "datatype": "number", "unit_family": "voltage", "canonical_unit": "V", "min": 12, "max": 1000, "required_for": ["core"], "variant_defining": true, "aliases": ["voltage", "supply voltage", "rated voltage", "input voltage", "vac"] },
        { "code": "phase", "name": "Phase", "datatype": "enum", "allowed_values": ["1", "3"], "required_for": ["core"], "variant_defining": true, "aliases": ["phase", "ph", "number of phases", "supply phase"] },
        { "code": "frequency_hz", "name": "Frequency", "datatype": "number", "unit_family": "frequency", "canonical_unit": "Hz", "min": 40, "max": 400, "required_for": ["ecommerce"], "aliases": ["frequency", "hz", "supply frequency"] },
