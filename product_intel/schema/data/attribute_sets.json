        { "code": "operating_temp_max_c", "name": "Max Operating Temperature", "datatype": "number", "unit_family": "temperature", "canonical_unit": "degC", "min": 0, "max": 600, "required_for": ["enhanced"], "aliases": ["max operating temperature", "maximum temperature", "temperature rating", "air temperature"] }
      ],
      "rules": [
        { "id": "bl_direct_drive_speed", "type": "implication", "if": "drive_type == 'Direct Drive'", "then_present": ["speed_rpm"], "message": "Direct-drive blowers must declare a rated speed." },
