        { "code": "end_connection", "name": "End Connection", "datatype": "enum", "allowed_values": ["NPT Threaded", "BSP Threaded", "Socket Weld", "Butt Weld", "Flanged", "Press", "Solder", "Compression", "Grooved"], "required_for": ["core"], "variant_defining": true, "aliases": ["end connection", "connection", "ends", "end type", "thread"] },
