# Copy this file to `.env` and fill in credentials for the cloud backend.
# `.env` is gitignored — nothing here is ever written to settings.json.
#
# You only need this if you switch the backend to AWS Bedrock. The default
# backend is Ollama (offline), and the pipeline also runs with no model at all.

# ── AWS Bedrock ────────────────────────────────────────────────────────
# Create an IAM user or role with the `bedrock:InvokeModel` permission,
# then paste its access key below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only needed for temporary / SSO credentials:
# AWS_SESSION_TOKEN=

# Region lives in settings.json (aws_region). Override it here if you prefer:
# AWS_DEFAULT_REGION=us-east-1

# Alternatively skip this file entirely and run `aws configure`, or use an
# EC2/ECS/EKS instance role — boto3's standard credential chain is used, so
# any of those work without changing anything.
