# Copy this file to `.env` and fill in the key for whichever cloud provider you use.
# `.env` is gitignored — your key never gets committed and is never written to
# settings.json.
#
# You only need a key if you switch the backend to cloud. The default backend is
# Ollama (offline), and the pipeline also runs with no model at all.

# ── OpenRouter (recommended cloud option) ──────────────────────────────
# Get a key: https://openrouter.ai/keys   (starts with sk-or-v1-)
OPENROUTER_API_KEY=

# ── OpenAI direct (optional alternative) ───────────────────────────────
# OPENAI_API_KEY=
